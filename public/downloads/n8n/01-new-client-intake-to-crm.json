      "parameters": {
        "width": 520,
        "height": 220,
        "content": "## New client intake → CRM\n**Portfolio demonstration. Fictional test data only.**\n\nTrigger: Google Form submission (test form)\n\n1. Replace every MOCK credential with your own *test* accounts.\n2. Replace YOUR_TEST_* IDs with test Sheets, Calendars, and Trello lists.\n3. Gmail nodes are disabled. Enable them only with a test inbox.\n4. Use \"Test: run manually\" to run with mock data.\n\nNot affiliated with any financial firm. Do not connect real client data."
      }
    },
    {
      "id": "d9b67362-3762-43f4-87e1-f9dc4c3ec95d",
      "name": "Test: run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        20,
        520
      ],
      "parameters": {}
    },
    {
      "id": "6af58011-eec8-44c1-9ed2-52484eaf1e63",
      "name": "Mock test data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        520
      ],
      "parameters": {
        "jsCode": "// FICTIONAL TEST DATA ONLY\nreturn [\n  { json: { 'Full Name': 'Olivia Test', Email: 'olivia.test@example.com', Phone: '805-555-0100', 'Ref #': 'SR-TEST-1201', Category: 'Address Change', Priority: 'Medium', Status: 'In Progress', 'Date Received': '2026-01-05', 'Target Date': '2026-01-09', 'Resolution Date': '', Client: 'Olivia Test', Owner: 'Coordinator', Purpose: 'Outstanding documents', 'Next Follow-up': '2026-01-08', Requirement: 'Signed form (mock)' } },\n  { json: { 'Full Name': 'Ben Sample', Email: 'ben.sample@example.com', Phone: '805-555-0101', 'Ref #': 'SR-TEST-1202', Category: 'Beneficiary Update', Priority: 'High', Status: 'Completed', 'Date Received': '2026-01-02', 'Target Date': '2026-01-06', 'Resolution Date': '2026-01-05', Client: 'Ben Sample', Owner: 'Operations', Purpose: 'Request status update', 'Next Follow-up': '2026-01-07', Requirement: 'Advisor review' } }\n];"
      }
    },
    {
      "id": "eb7eeb8b-750b-4a19-a05a-61a3344911e0",
      "name": "Intake form submitted",
      "position": [
        260,
        300
      ],
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "documentId": {
          "__rl": true,
          "value": "YOUR_TEST_FORM_RESPONSES_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Form Responses 1",
          "mode": "name"
        },
        "event": "rowAdded",
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "MOCK_CREDENTIAL_ID",
          "name": "MOCK_GOOGLE_SHEETS (replace with your test account)"
        }
      },
      "notes": "Google Forms writes responses to a linked Google Sheet; this trigger watches that sheet."
    },
    {
      "id": "0cb3b1b7-b155-4a91-8d53-d63a7fe4f0c0",
      "name": "Validate & normalize",
      "position": [
        500,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Validate required fields and normalize formats (test data only)\nreturn $input.all().map(item => {\n  const j = item.json;\n  const name = String(j['Full Name'] ?? j.name ?? '').trim();\n  const email = String(j['Email'] ?? j.email ?? '').trim().toLowerCase();\n  const digits = String(j['Phone'] ?? j.phone ?? '').replace(/\\D/g, '').slice(-10);\n  const phone = digits.length === 10 ? `(${digits.slice(0,3)}) ${digits.slice(3,6)}-${digits.slice(6)}` : '';\n  const errors = [];\n  if (!name) errors.push('Missing name');\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('Invalid email');\n  return { json: { name, email, phone, advisor: j['Preferred Advisor'] ?? 'Unassigned', valid: errors.length === 0, errors, receivedAt: new Date().toISOString() } };\n});"
      }
    },
